# ========================================================
# Mini Quiz Classroom - Environment Configuration
# Copy file này thành .env khi chạy local. PostgreSQL là bắt buộc.
# ========================================================

# Cổng lắng nghe (Cloud Run tự động set PORT=8080)
PORT=8080

# Môi trường chạy (development / production)
NODE_ENV=production

# URL công khai của website (Tùy chọn: nếu để trống server tự nhận diện theo request host của Cloud Run / Domain)
# APP_URL=https://your-domain.a.run.app

# Thư mục lưu dữ liệu xác thực (Tùy chọn, mặc định: ./data/auth)
# MQC_AUTH_DIR=./data/auth

# ========================================================
# Cấu hình Supabase & PostgreSQL Database
# Lấy tại Supabase Dashboard -> Project Settings -> API & Database
# ========================================================
# Supabase SDK chỉ phục vụ tích hợp/legacy import, không thay thế DATABASE_URL.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_KEY=your-supabase-service-role-key

# Bắt buộc: chuỗi kết nối PostgreSQL lấy từ Supabase Connect.
# Thay toàn bộ giá trị mẫu bằng URI thật; không commit .env chứa mật khẩu.
DATA_BACKEND=pg
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-pooler-host:5432/postgres
ALLOW_OFFLINE_MODE=false
# CORS_ORIGINS=https://your-frontend-domain.com

# ========================================================
# Google Gemini API Key (Tùy chọn: dùng cho tính năng AI)
# ========================================================
# GEMINI_API_KEY=your-gemini-api-key

