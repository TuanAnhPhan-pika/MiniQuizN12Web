# ========================================================
# Mini Quiz Classroom - Environment Configuration (Optional)
# Dự án dùng Node.js stdlib, các biến này đều có giá trị mặc định.
# ========================================================

# Cổng lắng nghe (Cloud Run tự động set PORT=8080)
PORT=8080

# Môi trường chạy (development / production)
NODE_ENV=production

# URL công khai của website (Tùy chọn: nếu để trống server tự nhận diện theo request host của Cloud Run / Domain)
# APP_URL=https://your-domain.a.run.app

# Thư mục lưu dữ liệu xác thực (Tùy chọn, mặc định: ./data/auth)
# MQC_AUTH_DIR=./data/auth

# ========================================================
# Cấu hình Supabase & PostgreSQL Database
# Lấy tại Supabase Dashboard -> Project Settings -> API & Database
# ========================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Hoặc chuỗi kết nối trực tiếp PostgreSQL từ Supabase (URI Pooler)
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ========================================================
# Google Gemini API Key (Tùy chọn: dùng cho tính năng AI)
# ========================================================
# GEMINI_API_KEY=your-gemini-api-key

